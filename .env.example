# Copy to .env (git-ignored) and fill in real values. Never commit .env.
# Used by docker-compose.yml and by ./run-dev.sh (loaded automatically).

# PostgreSQL (core-db)
DB_PASSWORD=change-me

# RabbitMQ (broker)
RABBITMQ_PASSWORD=change-me

# core-service HTTP Basic login for local development only
DEV_USER=manager
DEV_PASSWORD=change-me
